{
  "name": "dsh-policy-ledger",
  "version": "0.3.0",
  "description": "Read-only install doctor: capability snapshot, tarball assert and install diagnosis.",
  "type": "module",
  "main": "./lib/plugin/index.js",
  "types": "./lib/plugin/index.d.ts",
  "bin": {
    "dsh-policy-ledger": "bin/dsh-policy-ledger.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "docs/assets",
    "SECURITY.md",
    "PRIVACY.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "TROUBLESHOOTING.md",
    "screenshots.json",
    "icon.svg",
    "samples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input",
      "prompt": "帮我用自带样例做一次安装体检：这个包有什么能力、风险几级、装失败的那行日志是什么原因？",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "用户指定的本地 npm 包 .tgz 与安装日志（样例：samples/quickstart/input）"
      ],
      "writes": [
        "$DSH_HOME/storages/dsh-policy-ledger"
      ],
      "network": true,
      "external": []
    },
    "capabilities": [
      "network:egress",
      "tools:register"
    ],
    "labels": []
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.4.0",
    "node": ">=24.9.0 <25"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "gate:sku03": "node scripts/gate-sku03.mjs",
    "prepublishOnly": "node scripts/check-npm-name.mjs",
    "pack:check": "npm pack --dry-run --json > pack.json && node scripts/check-pack.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "trust",
    "install-doctor",
    "capability-snapshot",
    "perrylink",
    "capability",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-policy-ledger.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.3 <0.4.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.4.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "homepage": "https://perrylink.github.io/dsh-plugins/packages/dsh-policy-ledger.html",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-policy-ledger/issues"
  },
  "icon": "icon.svg",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
